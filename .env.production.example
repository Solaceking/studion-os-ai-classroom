# =============================================================================
# Studion OS AI Classroom - Production Environment Template
# Copy to .env.production (or configure directly in your host secret manager)
# =============================================================================

# Required in production
NODE_ENV=production
PORT=3000
ENGINE_API_KEY=replace-with-a-long-random-secret

# --- LLM Providers -----------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODELS=

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODELS=

GOOGLE_API_KEY=
GOOGLE_BASE_URL=
GOOGLE_MODELS=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODELS=

# --- TTS ---------------------------------------------------------------------
TTS_OPENAI_API_KEY=
TTS_OPENAI_BASE_URL=

# --- ASR ---------------------------------------------------------------------
ASR_OPENAI_API_KEY=
ASR_OPENAI_BASE_URL=

# --- PDF ---------------------------------------------------------------------
PDF_UNPDF_API_KEY=
PDF_UNPDF_BASE_URL=
PDF_MINERU_API_KEY=
PDF_MINERU_BASE_URL=

# --- Web Search --------------------------------------------------------------
TAVILY_API_KEY=

# Optional server-side default model (provider-prefixed)
# e.g. google:gemini-2.5-flash, openai:gpt-4.1-mini
DEFAULT_MODEL=

# Optional proxy
# HTTP_PROXY=
# HTTPS_PROXY=
